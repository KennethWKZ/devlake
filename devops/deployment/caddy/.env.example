# Copy to .env and fill in. No secrets here: AWS credentials come from the instance role.
CADDY_IMAGE=devlake-caddy:2.11.9-route53-1.6.3

# Public DNS names (A records pointing at this host's address).
DEVLAKE_UI_HOST=devlake.example.com
OTEL_HOST=otel.devlake.example.com

# Route 53 hosted zone that holds the names above (for the DNS challenge).
ROUTE53_HOSTED_ZONE_ID=Z0000000000000000000

# Profile in aws-config that the DNS provider uses.
AWS_PROFILE=acme

# Upstreams on this host (DevLake's config-ui port and the collector's OTLP/HTTP port).
DEVLAKE_UI_UPSTREAM=127.0.0.1:4000
OTEL_UPSTREAM=127.0.0.1:4319
