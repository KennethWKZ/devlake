# HTTPS in front of DevLake on a host that only trusted networks can reach.
# Certificates come from Let's Encrypt through the Route 53 DNS challenge, so the host
# needs no inbound access from the internet. Values come from .env (see .env.example).
{
	# Serve HTTPS only: no HTTP listener for redirects.
	auto_https disable_redirects
	http_port {$CADDY_HTTP_PORT:8081}

	acme_dns route53 {
		hosted_zone_id {$ROUTE53_HOSTED_ZONE_ID}
		profile {$AWS_PROFILE:default}
	}
}

# One file per site in sites/; mount only the ones you use.
import /etc/caddy/sites/*.caddy
